{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "baseUrl": ".",
    "strict": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "lib",
    "artifacts",
    "scripts",
    "mobile-scripts"
  ],
  "references": [
    {
      "path": "./lib/api-client-react"
    }
  ]
}
